{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../node_modules/@types"
    ],
    "jsx": "preserve",
    "baseUrl": "../..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "*.ts",
    "stage3/*.ts"
  ]
}
