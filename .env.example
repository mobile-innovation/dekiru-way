# ---------------------------------------------------------------------------
# できる道 (dekiru-way) 環境変数サンプル
# `cp .env.example .env` して値を設定する。
# ---------------------------------------------------------------------------

# --- Database (docker compose の db サービス, ホスト側ポート 5433) ---
DATABASE_URL="postgresql://dekiru:dekiru@localhost:5433/dekiru?schema=public"

# --- サイト公開URL (OGP og:image / og:url / canonical の絶対URL基点) ---
# 本番では必ず https の本番ドメインに設定する。未設定はローカル開発用フォールバック。
SITE_URL="http://localhost:3000"

# --- Auth.js (NextAuth v5) ---
# `openssl rand -base64 32` などで生成した値を入れる
AUTH_SECRET="change-me-in-local-dev"
# 本番では公開URL。ローカルは未設定でも可。
# AUTH_URL="http://localhost:3000"

# --- Google OAuth クレデンシャル ---
# https://console.cloud.google.com/apis/credentials で作成
# 承認済みリダイレクトURI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI (任意) ---
# 未設定の場合、AI エンドポイントはスタブ応答を返す。
# 未設定だと投稿のモデレーション AI も動かないため、公開投稿はすべて「不明」= 運営レビュー待ちになる。
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- 管理画面 (モデレーション) ---
# 管理者ログインはアプリ利用者 (Google) とは別系統のメール + パスワード。
# セッション署名には AUTH_SECRET を流用するので、AUTH_SECRET は必須。
# ADMIN_EMAIL / ADMIN_PASSWORD は初期管理者のブートストラップ用
# (`npm run db:seed` と `npm run admin:create` だけが参照。実行時の認証には使わない)。
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="dekiru-admin"
# 管理セッションの有効時間 (時間・既定 8)
ADMIN_SESSION_TTL_HOURS="8"
# "false" にすると公開時に AI を呼ばず即 approved にする運用スイッチ (既定 = 有効)。
# E2E は自動で false。ローカルで AI 課金・遅延を避けたいときにも使える。
AI_MODERATION_ENABLED="true"

# --- 意味検索 (Embedding・試験導入。既定は無効) ---
# "true" かつ EMBEDDING_MODEL 設定時だけ、/experiences?sem=1 で意味の近い経験を探せる（画面の変更は無し）。
# モデルはサーバー上でローカル実行（Transformers.js / CPU）。外部の従量課金 API は使わない。
# 有効にするとメモリが約 0.4〜0.5GB 増える（初回の ?sem=1 検索で読み込む。無効なら増えない）。
SEMANTIC_SEARCH_ENABLED="false"
# 例: multilingual-e5-small（q8 = onnx/model_quantized.onnx）。e5 系は接頭辞が必須・平均 pooling。
EMBEDDING_MODEL="Xenova/multilingual-e5-small"
EMBEDDING_DTYPE="q8"
EMBEDDING_POOLING="mean"
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# モデルファイルの置き場所（<dir>/<EMBEDDING_MODEL>/config.json など）。本番は事前に配置して ALLOW_REMOTE=false。
EMBEDDING_MODEL_PATH=""
# "true" なら初回に Hugging Face からモデルを取得して EMBEDDING_MODEL_PATH に保存する（ローカル開発用）。
EMBEDDING_ALLOW_REMOTE="false"
# 推論スレッド数（既定 1。増やすと同じサーバーの Next.js が遅くなることがある）
EMBEDDING_THREADS="1"
# 意味検索で候補にする件数（道・試したことそれぞれ）
SEMANTIC_SEARCH_TOP_K="20"
# 1 位との類似度の差がこの値以内の結果だけを出す（既定 0.02。大きくすると件数も無関係な結果も増える）
SEMANTIC_SEARCH_MARGIN="0.02"

# --- 広告 (広告表示方針 v1) ---
# "true" のときだけ、検索一覧と道詳細の 2 枠に広告を描画する。既定は無効。
# トップ・自分の道・各フォーム・ログイン・アカウントには出さない。
ADS_ENABLED="false"
# Google AdSense。空ならプレースホルダのまま（実広告は出ない）。
# 広告は非パーソナライズ（文脈のみ・行動追跡なし）で配信する。
# パブリッシャ ID と、広告ユニットごとの slot ID。
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT_SEARCH=""
NEXT_PUBLIC_ADSENSE_SLOT_ROAD=""

# --- 管理者への審査待ち登録通知メール (Resend API) ---
# 3 つすべて設定しないと送信しない (未設定でもログに記録するだけで登録処理自体は失敗させない)。
MAIL_PROVIDER_API_KEY=""
ADMIN_NOTIFICATION_EMAIL=""
MAIL_FROM_ADDRESS="noreply@dekirumichi.net"

# --- 公開API・スクレイピング対策 (追加指示書 v1) ---
# 手動でブロックする IP をカンマ区切りで指定 (将来の管理画面の代替)。
BLOCKED_IPS=""
# アクセスログのクライアント識別子を匿名化するときのソルト。
ACCESS_LOG_SALT="change-me"

# --- 開発補助 ---
# "true" のとき E2E 用のモックログイン (/api/test/login) を有効化する。本番では絶対に true にしない。
E2E_TEST_LOGIN="false"
