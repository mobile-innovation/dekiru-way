// できる道 (dekiru-way) データモデル
// 一次仕様: 開発開始指示書 v1 セクション 4 / 16
//
// 方針:
//   - 病名・障害名・年齢・介護度は必須プロフィールにしない (User は最小限)
//   - 「道」は専用テーブルを持たず Road + Attempt から生成する
//   - Experience 独立テーブルは作らない。公開された Attempt を「経験」として扱う
//   - result は必ず 5 分類。失敗 (failed) も価値ある経験として保存し、自動削除しない

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 試したことの結果。必ずこの 5 分類のいずれか。
///   success   = できるようになった
///   partial   = 少しできた
///   no_change = 変化はなかった
///   failed    = うまくいかなかった
///   ongoing   = まだ試している
enum AttemptResult {
  success
  partial
  no_change
  failed
  ongoing
}

/// 公開しようとした Attempt (投稿) のモデレーション状態。
///   pending  = AI が NG / 不明と判定。運営レビュー待ち。公開検索には出さない
///   approved = 公開可 (AI が OK、または運営が許可)
///   rejected = 運営が却下。公開しない
enum ModerationStatus {
  pending
  approved
  rejected
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  /// Google OpenID Connect の sub。認証プロバイダをまたいだ一意キー。
  googleSub   String   @unique @map("google_sub")
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roads         Road[]
  attemptLikes  AttemptLike[]
  attemptReads  AttemptRead[]
  notifications Notification[]

  @@map("users")
}

/// 一つの困りごと・目標に対する試行錯誤のまとまり。
model Road {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  /// 以前できていたこと
  previouslyAble String?   @map("previously_able")
  /// 何ができなくて困っているか
  difficulty    String?
  /// やりたいこと・目標
  goal          String?
  /// いつ頃から難しくなったか
  startedAt     DateTime?  @map("started_at") @db.Date
  /// 困っている場面
  situation     String?
  memo          String?
  /// 自由記述の状態ラベル (例: 継続中 / 一区切り)
  status        String?
  /// 現在の進捗
  progress      String?
  /// 次に試すこと
  nextAction    String?    @map("next_action")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // 道そのものにはモデレーション状態を持たない。道が公開面に出るかは
  // 「承認済みの公開経験 (Attempt) を 1 つ以上持つか」だけで決まる (PUBLIC_ATTEMPT_WHERE)。

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts Attempt[]
  roadTags RoadTag[]

  @@index([userId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("roads")
}

/// Road 内で試した一つの方法と結果。
model Attempt {
  id          String        @id @default(uuid()) @db.Uuid
  roadId      String        @map("road_id") @db.Uuid
  /// 何を試したか (必須)
  method      String
  result      AttemptResult
  /// 試した時期
  triedAt     DateTime?     @map("tried_at") @db.Date
  /// メモ・気づき
  memo        String?
  /// この方法で「やりたいこと」がどのくらいできるようになったと本人が感じたか (0〜100)。
  /// 本人入力のみ。AI で推定・自動計算しない。result とは別の情報。
  achievementPercent Int?    @map("achievement_percent")
  /// そのとき、どんな気持ちだったか (本人の自由記述。成功時に限らない)
  feeling            String? @map("feeling")
  /// その方法を試した後、実際にどういう状態になったか (result より具体的な補足)
  stateAfter         String? @map("state_after")
  /// その後、次に何を試すことにしたか (この Attempt 起点の次の行動)
  nextAction         String? @map("next_action")
  /// 実際にこの方法の前に試した Attempt (同じ Road 内のみ)。
  /// 日付や画面の並びから推測して設定してはいけない。
  previousAttemptId  String? @map("previous_attempt_id") @db.Uuid
  /// この Attempt を「経験」として公開するか。初期値 false。
  isPublished Boolean       @default(false) @map("is_published")
  /// 公開ゲート。`isPublished && moderationStatus == approved` のときだけ公開面に出す。
  /// 新規行は pending。既存の公開投稿はマイグレーションで approved にバックフィルする。
  moderationStatus   ModerationStatus @default(pending) @map("moderation_status")
  /// 最新の AI 判定 ("ok" | "ng" | "unknown")。
  aiVerdict          String?          @map("ai_verdict")
  /// AI が挙げた理由 (日本語 1〜2 文)。
  aiReason           String?          @map("ai_reason")
  /// AI が付けたカテゴリフラグ (personal_info / medical_assertion / defamation / spam / inappropriate / other)。
  aiCategories       String[]         @map("ai_categories")
  /// AI が最後にチェックした時刻。
  aiCheckedAt        DateTime?        @map("ai_checked_at")
  /// 最後に手動でモデレーション判断した管理者。
  moderatedByAdminId String?          @map("moderated_by_admin_id") @db.Uuid
  /// 手動判断の時刻。
  moderatedAt        DateTime?        @map("moderated_at")
  /// 運営メモ (任意)。
  moderationNote     String?          @map("moderation_note")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  road            Road           @relation(fields: [roadId], references: [id], onDelete: Cascade)
  previousAttempt Attempt?       @relation("AttemptChain", fields: [previousAttemptId], references: [id], onDelete: SetNull)
  nextAttempts    Attempt[]      @relation("AttemptChain")
  moderatedByAdmin AdminUser?    @relation(fields: [moderatedByAdminId], references: [id], onDelete: SetNull)
  likes           AttemptLike[]
  reads           AttemptRead[]
  notifications   Notification[]

  @@index([roadId])
  @@index([result])
  @@index([isPublished])
  @@index([triedAt])
  @@index([previousAttemptId])
  @@index([moderationStatus])
  @@index([isPublished, moderationStatus])
  @@map("attempts")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  roadTags RoadTag[]

  @@index([name])
  @@map("tags")
}

/// 管理画面 (モデレーション) にログインできる運営者。
/// アプリ利用者 (User / Google ログイン) とは完全に別系統。
model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  /// "scrypt$<N>$<saltBase64>$<hashBase64>" 形式。
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs         AdminAuditLog[]
  moderatedAttempts Attempt[]

  @@map("admin_users")
}

/// 管理画面での操作記録 (監査ログ)。
model AdminAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  /// login / approve / reject / unpublish / republish / recheck など。
  action    String
  /// 対象の投稿 (Attempt) id。操作によっては無い。
  attemptId String?  @map("attempt_id") @db.Uuid
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([attemptId])
  @@map("admin_audit_logs")
}

/// Road と Tag の中間テーブル。複合主キー (road_id, tag_id)。
model RoadTag {
  roadId String @map("road_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  road Road @relation(fields: [roadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([roadId, tagId])
  @@index([tagId])
  @@map("road_tags")
}

/// 公開された経験 (Attempt) への「いいね」。
/// - 目的は投稿者へ「参考になった」ことを伝えること。人気度・ランキングには使わない。
/// - 1 ユーザー 1 経験につき 1 件 (UNIQUE)。自分の経験にはいいねできない (アプリ層で拒否)。
/// - いいね数は画面に出さない。保存するのは「いいね済みか」「取り消せるか」「通知を作る」ため。
model AttemptLike {
  id        String   @id @default(uuid()) @db.Uuid
  attemptId String   @map("attempt_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([attemptId, userId])
  @@index([userId])
  @@map("attempt_likes")
}

/// 公開された経験 (Attempt) を、そのユーザーが「実際に開いて見た」記録。
/// - Attempt の属性ではなく「誰が読んだか」というユーザーごとの状態なので専用テーブルにする
///   (attempts.is_read は作らない)。
/// - 既読数・閲覧数は出さない。検索順位にも使わない。個人用の状態。
/// - 1 ユーザー 1 経験につき 1 件 (UNIQUE)。既読日時 (read_at) は将来の「最近見た経験」用に保持。
model AttemptRead {
  id        String   @id @default(uuid()) @db.Uuid
  attemptId String   @map("attempt_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attemptId])
  @@index([attemptId])
  @@map("attempt_reads")
}

/// ユーザーへの通知。現状は「自分の経験にいいねが届いた」(attempt_liked) のみ。
/// - 誰がいいねしたかは持たない・出さない (SNS 的な表現を避ける)。
/// - いいね取り消しでは通知を消さない (その時点で評価された、という出来事として扱う)。
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// 通知種別。例: "attempt_liked"
  type      String
  /// 対象の経験 (Attempt)。種別によっては無い。
  attemptId String?  @map("attempt_id") @db.Uuid
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt Attempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
